{
  "name": "diagram-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Diagram Studio: turn complex ideas into visual stories. AI diagram generation, Excalidraw editing and scene-based presentations.",
  "packageManager": "bun@1.2.0",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-http-header-size=65536 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "bun run typecheck && bun run lint && bun run test",
    "worker:render": "tsx --env-file=.env.local src/features/exports/worker/render-worker.ts",
    "remotion:studio": "remotion studio src/features/exports/remotion/index.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/excalidraw": "^0.18.0",
    "@remotion/bundler": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "lucide-react": "^0.460.0",
    "next": "^16.0.0",
    "radix-ui": "^1.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "^4.0.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@remotion/cli": "^4.0.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
