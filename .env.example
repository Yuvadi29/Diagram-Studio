# ── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_…). Older projects: use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…), or the legacy SUPABASE_SERVICE_ROLE_KEY. SERVER ONLY.
# Only the background video render worker uses it; the web app does not need it.
SUPABASE_SECRET_KEY=

# ── Cloud AI (Gemini) ───────────────────────────────────────────────────────
# Server-side only. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Request timeout for a single Gemini call (ms)
GEMINI_TIMEOUT_MS=60000

# ── AI rate limits (per user, cloud provider) ───────────────────────────────
AI_RATE_LIMIT_PER_10_MIN=30
AI_RATE_LIMIT_PER_DAY=300

# ── Local AI (Ollama) ───────────────────────────────────────────────────────
# Default endpoint suggested to users. Ollama is called FROM THE USER'S BROWSER,
# never from the server, so "localhost" here means the visitor's own machine.
NEXT_PUBLIC_OLLAMA_DEFAULT_URL=http://localhost:11434
NEXT_PUBLIC_OLLAMA_DEFAULT_MODEL=llama3.1

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Video render worker (optional, Phase 5) ─────────────────────────────────
# Path to a Chrome/Chromium binary; leave empty to let Remotion download its own.
REMOTION_BROWSER_EXECUTABLE=
RENDER_WORKER_POLL_MS=5000
